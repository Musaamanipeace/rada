# =============================================================================
# Rada Environment Configuration (.env.example)
# Copy this file to .env for local development. Never commit real secrets.
# =============================================================================

# --- Application ---
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Database (PostgreSQL + Prisma) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/rada?schema=public"

# --- Authentication (Auth.js) ---
AUTH_SECRET="replace-with-openssl-rand-base64-32"
EMAIL_SERVER_HOST="localhost"
EMAIL_SERVER_PORT="1025"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="noreply@rada.example"

# --- Feature Flags & System Config ---
# D23: Watch Ads is behind a switch that is OFF at launch until the first advertiser is approved.
FEATURE_WATCH_ADS_ENABLED="false"
# Phase 5: Global kill switch for automated import connectors
FEATURE_AUTOMATED_IMPORTS_ENABLED="false"

# --- AI Assistant (Phase 4 Portfolio Assistant — behind src/lib/ai interface) ---
# Provider is TBD (see docs/product/open-questions.md). Leave empty until decided.
AI_PROVIDER="none"
AI_API_KEY=""

# --- Media Storage (Phase 6 Advertiser Assets) ---
# Storage/transcoding provider is TBD for Phase 6d.
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
